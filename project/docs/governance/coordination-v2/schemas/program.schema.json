{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hukuk-yazilimi:coordination-v2:program.schema.json",
  "title": "GOV-COORD-V2 Program Identity Manifest",
  "description": "Program KIMLIK ve active-status manifesti. Program ICERIGI tasinmaz; task listesi cikarilmaz. DERIVED / NON-AUTHORITATIVE. Bkz. governance-orchestration-contract-v2.md SS9.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFromMainSha", "authority", "programs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedFromMainSha": { "$ref": "#/$defs/gitObjectId" },
    "authority": {
      "const": "DERIVED / NON-AUTHORITATIVE",
      "description": "Bu manifest semantic veya execution authority URETMEZ."
    },
    "taxonomyQuestionOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "resolved"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "resolved": {
          "const": false,
          "description": "'5 mi 6 mi program' sorusu KANITLA raporlanir, KARARA BAGLANMAZ (SS9)."
        },
        "candidateFoldings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/program" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "canonicalName",
        "taxonomyLevel",
        "governanceSourceFiles",
        "activeStatus",
        "authorizationState",
        "authorizationEvidence",
        "liveExecutionEligibility"
      ],
      "properties": {
        "programId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
        },
        "canonicalName": { "type": "string", "minLength": 1 },
        "taxonomyLevel": {
          "enum": ["PROGRAM", "SUBPROGRAM", "UNKNOWN"],
          "description": "UNKNOWN, taksonomi sorusunun KARARA BAGLANMADIGINI kaydeder (SS9). Ortuk karar vermemek icin zorunlu ucuncu deger."
        },
        "parentProgramId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,31}$"
        },
        "governanceSourceFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "activeStatus": {
          "enum": [
            "ACTIVE_ROADMAP_TRACK",
            "NOT_ON_ACTIVE_ROADMAP",
            "UNKNOWN"
          ]
        },
        "authorizationState": {
          "enum": [
            "AUTHORIZED",
            "OWNER_GATED",
            "NOT_AUTHORIZED",
            "BLOCKED",
            "UNKNOWN_REQUIRES_OWNER_REVIEW"
          ]
        },
        "authorizationEvidence": { "$ref": "#/$defs/evidence" },
        "liveExecutionEligibility": {
          "enum": ["ELIGIBLE", "DENIED"],
          "description": "authorizationState AUTHORIZED disindaysa fail-closed DENIED (SS9)."
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": { "authorizationState": { "const": "AUTHORIZED" } }
            }
          },
          "then": {
            "properties": { "liveExecutionEligibility": { "const": "DENIED" } }
          }
        },
        {
          "if": { "properties": { "taxonomyLevel": { "const": "SUBPROGRAM" } } },
          "then": { "required": ["parentProgramId"] }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceCommitSha",
        "startLine",
        "endLine",
        "exactExcerpt",
        "excerptSha256"
      ],
      "description": "Satir numarasi TEK BASINA yetersizdir; dosya ilerleyince sessizce eskir (SS9).",
      "properties": {
        "sourcePath": { "$ref": "#/$defs/repoPath" },
        "sourceCommitSha": { "$ref": "#/$defs/gitObjectId" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "exactExcerpt": { "type": "string", "minLength": 1 },
        "excerptSha256": {
          "$ref": "#/$defs/sha256",
          "description": "UTF-8 / BOM yok / LF / NFC uzerinden SHA-256 (SS12)."
        }
      }
    }
  }
}
