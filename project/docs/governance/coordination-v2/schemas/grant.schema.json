{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hukuk-yazilimi:coordination-v2:grant.schema.json",
  "title": "GOV-COORD-V2 Standing Execution Grant",
  "description": "Owner-ratified workstream-level execution grant. Orchestrator bu kaydi URETEMEZ; yalniz dogrular. Bkz. governance-orchestration-contract-v2.md SS2, SS15.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "workstream",
    "semanticAuthorityRef",
    "executionGrantRef",
    "ownerRatificationEvidence",
    "authorizedTasks",
    "revocationPath",
    "manualMergeRequired"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "grantId": { "$ref": "#/$defs/identifier" },
    "workstream": { "$ref": "#/$defs/identifier" },
    "semanticAuthorityRef": {
      "$ref": "#/$defs/authorityRef",
      "description": "Degisikligin ANLAMINI ve owner/domain kararini gosterir."
    },
    "executionGrantRef": {
      "$ref": "#/$defs/authorityRef",
      "description": "Executor'in o bounded islemi YAPABILMESINI gosterir. semanticAuthorityRef ile ayni path + recordId ile karsilanamaz (SYS-DEC-003)."
    },
    "ownerRatificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceCommitSha", "exactExcerpt", "excerptSha256"],
      "properties": {
        "sourcePath": { "$ref": "#/$defs/repoPath" },
        "sourceCommitSha": { "$ref": "#/$defs/gitObjectId" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "exactExcerpt": { "type": "string", "minLength": 1 },
        "excerptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorizedTasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pinnedTask" },
      "description": "Task ADIYLA degil, immutable hash kimligiyle pinlenir."
    },
    "executionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executionPlanRef", "executionPlanCommitSha", "executionPlanContentSha256"],
      "properties": {
        "executionPlanRef": { "$ref": "#/$defs/repoPath" },
        "executionPlanCommitSha": { "$ref": "#/$defs/gitObjectId" },
        "executionPlanContentSha256": { "$ref": "#/$defs/sha256" }
      },
      "description": "Alternatif butunsel pinleme (SS2)."
    },
    "allowedModuleRoots": {
      "type": "array",
      "items": { "$ref": "#/$defs/repoRoot" },
      "uniqueItems": true,
      "description": "Grant-seviyesi ust sinir. Her task'in kendi boundaryPolicy'si bunun ALT KUMESI olmalidir."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "noExpiryPolicyRef": {
      "$ref": "#/$defs/authorityRef",
      "description": "expiresAt yoksa acik owner no-expiry karari zorunludur."
    },
    "revocationPath": { "$ref": "#/$defs/repoPath" },
    "manualMergeRequired": {
      "const": true,
      "description": "AUTO-MERGE her durumda yasaktir (SS5)."
    },
    "grantSha256": { "$ref": "#/$defs/sha256" }
  },
  "anyOf": [
    { "required": ["expiresAt"] },
    { "required": ["noExpiryPolicyRef"] }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "identifier": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "repoRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*/$"
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recordId", "sourcePath"],
      "properties": {
        "kind": { "enum": ["SEMANTIC_AUTHORITY", "EXECUTION_GRANT"] },
        "recordId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "sourcePath": { "$ref": "#/$defs/repoPath" },
        "sourceCommitSha": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "pinnedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "taskSpecVersion",
        "taskSpecSha256",
        "declaredIntentSha256",
        "boundaryPolicySha256",
        "requiredTestsSha256"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/identifier" },
        "taskSpecVersion": { "type": "integer", "minimum": 1 },
        "taskSpecSha256": { "$ref": "#/$defs/sha256" },
        "declaredIntentSha256": { "$ref": "#/$defs/sha256" },
        "boundaryPolicySha256": { "$ref": "#/$defs/sha256" },
        "requiredTestsSha256": { "$ref": "#/$defs/sha256" },
        "predecessorTaskIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    }
  }
}
