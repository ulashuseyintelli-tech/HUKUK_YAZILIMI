{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hukuk-yazilimi:coordination-v2:executor.schema.json",
  "title": "GOV-COORD-V2 Executor Attempt Manifest",
  "description": "Executor resolution + process contract kaydi. Resolved path task attempt basinda PINLENIR. Bkz. governance-orchestration-contract-v2.md SS7.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executorLane",
    "state",
    "resolutionSource",
    "resolvedAbsolutePath",
    "version",
    "smokeExitCode",
    "smokeResult",
    "workingDirectory",
    "environmentAllowlist"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "executorLane": { "enum": ["CLAUDE_LOCAL", "CODEX_LOCAL"] },
    "state": {
      "enum": ["AVAILABLE", "UNAVAILABLE"],
      "description": "Resolution veya smoke basarisizsa UNAVAILABLE. Bu 'executor kurulu degil' DEMEK DEGILDIR (SS7.1)."
    },
    "resolutionSource": {
      "enum": [
        "EXPLICIT_CONFIGURED_PATH",
        "PATH_RESOLUTION",
        "KNOWN_INSTALLATION_FALLBACK"
      ]
    },
    "resolvedAbsolutePath": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "smokeExitCode": { "type": "integer" },
    "smokeResult": { "enum": ["PASS", "FAIL"] },
    "workingDirectory": {
      "type": "string",
      "minLength": 1,
      "description": "Isolated worktree root; pinlenir."
    },
    "environmentAllowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "description": "Parent environment BUTUNUYLE miras alinmaz; bu liste disi degisken gecirilmez (SS7.3)."
    },
    "spawnPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useShellExecute", "argv"],
      "properties": {
        "useShellExecute": { "const": false },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "promptTransport": { "enum": ["SINGLE_ARGUMENT", "STDIN_PAYLOAD"] }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "gracePeriodMs": { "type": "integer", "minimum": 0 },
        "maxStdoutBytes": { "type": "integer", "minimum": 1 },
        "maxStderrBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "NORMAL_EXIT",
            "TIMEOUT",
            "OWNER_CANCELLATION",
            "LEASE_EPOCH_LOSS"
          ],
          "description": "Ucu de AYNI cancellation primitive'ini kullanir (SS7.5)."
        },
        "gracefulAttempted": { "type": "boolean" },
        "processTreeTerminated": { "type": "boolean" },
        "orphanProcessDetected": {
          "type": "boolean",
          "description": "true ise VALIDATION FAILURE (SS7.5)."
        }
      }
    },
    "leaseEpochAtSpawn": { "type": "integer", "minimum": 1 },
    "holderTokenAtSpawn": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "AVAILABLE" } } },
      "then": {
        "properties": {
          "smokeResult": { "const": "PASS" },
          "smokeExitCode": { "const": 0 }
        }
      }
    }
  ]
}
