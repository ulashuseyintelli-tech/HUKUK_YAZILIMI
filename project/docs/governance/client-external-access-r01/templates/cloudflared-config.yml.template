# CLIENT DIŞ ERİŞİM — giden tünel şablonu (SEÇİLEN YOL, R03). CANLIYA UYGULANMADI.
#
# MİMARİ (paket §19): Cloudflare for SaaS özel adı + yardımcı bölge + adlandırılmış tünel.
#   müvekkil → bilgi.tellihukuk.com (Turhost'ta CNAME → yardımcı bölgedeki SaaS hedefi)
#            → Cloudflare kenarı (özel ad sertifikası burada)
#            → yardımcı bölgedeki FALLBACK ORIGIN (tünelin public hostname'i)
#            → cloudflared (giden 7844; gelen port AÇILMAZ; 80/443 NAT'ına DOKUNULMAZ)
#            → Caddy 127.0.0.1:8081 (tünel profili: 18 çift + varsayılan RET + CF-Connecting-IP)
#            → Web 127.0.0.1:3002 / API 127.0.0.1:8080
#
# Resmî dayanak: Cloudflare Reference Architecture — "The fallback origin is a CNAME DNS record
# that points to a public hostname exposed by Cloudflare Tunnel."
#
# Parametreler:
#   <TUNNEL_ID> · <CREDENTIALS_PATH>
#   <PUBLIC_HOST>          müvekkilin gördüğü ad (bilgi.tellihukuk.com)
#   <FALLBACK_ORIGIN_HOST> yardımcı bölgedeki fallback origin adı (ör. origin.<yardımcı-alan>)
#
# NEDEN İKİ HOSTNAME KURALI: özel ad trafiğinin tünele hangi Host başlığıyla ulaştığı rehberde
# açıkça yazılmaz. Tasarım bundan BAĞIMSIZDIR: iki kural da AYNI ve TEK hedefe (Caddy) gider;
# başka her Host 404 alır. Kenar kararı (yöntem + yol + admin reddi) Caddy'dedir, Host'a
# bakmaz; bu yüzden yardımcı ad üzerinden gelen istek de AYNI 18 çifte takılır
# (ölçüm: scripts/edge-probe.ps1 -HostHeader ... ve scripts/tunnel-ingress-probe.ps1).
#
# API ve Web burada HİÇ geçmez; tünelin ulaşabildiği tek hedef Caddy'dir.

tunnel: <TUNNEL_ID>
credentials-file: <CREDENTIALS_PATH>

ingress:
  # Yardımcı bölgedeki fallback origin — rehberdeki "public hostname exposed by Cloudflare Tunnel".
  - hostname: <FALLBACK_ORIGIN_HOST>
    service: http://127.0.0.1:8081
    originRequest:
      httpHostHeader: <PUBLIC_HOST>
  # Özel ad Host başlığıyla gelirse de aynı hedef.
  - hostname: <PUBLIC_HOST>
    service: http://127.0.0.1:8081
    originRequest:
      httpHostHeader: <PUBLIC_HOST>
  # Zorunlu son kural: eşleşmeyen her hostname reddedilir.
  - service: http_status:404
