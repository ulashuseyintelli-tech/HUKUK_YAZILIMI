# CLIENT DIŞ ERİŞİM — giden tünel şablonu (ÖNERİLEN yol). CANLIYA UYGULANMADI.
# Parametreler: <TUNNEL_ID> · <CREDENTIALS_PATH> · <PUBLIC_HOST>.
#
# TOPOLOJİ (R02): tünel → Caddy 127.0.0.1:8081 → Web 127.0.0.1:3002 / API 127.0.0.1:8080.
#
# NEDEN TEK GİRİŞ: tünel girişi yalnız YOL eşler, YÖNTEM eşlemez (cloudflared belgesi;
# ingress kurallarının eşleşme alanları hostname ve path'tir). Yöntem kısıtı bu yüzden
# kenarda tek yerde, Caddy'de verilir. R01'de bu dosya doğrudan 8080 ve 3002'ye iki ayrı
# ingress kuralı taşıyordu: o kurallar yöntem kısıtsız bir alternatif geçiş oluşturuyordu.
# Artık API ve Web burada HİÇ geçmez — tünelin ulaşabildiği tek hedef Caddy'dir.
#
# İstemci IP: sağlayıcı istemci adresini X-Forwarded-For'un SONUNA ekler; Caddy bu başlığı
# SİLİP kendi gördüğü adresi yazar, API `trust proxy=1` ile en sağdaki değeri okur.
# Kurulumda sahte başlıkla ölçülür (paket §3 madde 2-3).
#
# Yayından önce doğrulanır: Caddy çalışmıyorken tünel hiçbir şey sunamaz (502/1033),
# yani kenar kararı atlanamaz.

tunnel: <TUNNEL_ID>
credentials-file: <CREDENTIALS_PATH>

ingress:
  # Yayınlanan tek host → tek arka uç: Caddy. Yol ve yöntem kararının tamamı Caddy'dedir.
  - hostname: <PUBLIC_HOST>
    service: http://127.0.0.1:8081
    originRequest:
      # Caddy loopback'te düz HTTP dinler; TLS sağlayıcı kenarında sonlanır.
      httpHostHeader: <PUBLIC_HOST>
  # Zorunlu son kural: eşleşmeyen her hostname reddedilir.
  - service: http_status:404
