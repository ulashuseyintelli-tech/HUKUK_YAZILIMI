# CLIENT DIŞ ERİŞİM — Caddy şablonu. CANLIYA UYGULANMADI.
#
# TOPOLOJİ (R02): tünel → Caddy (YALNIZ loopback) → Web 3002 / API 8080.
# Tünel yalnız Caddy'ye ulaşır; cloudflared yapılandırmasında API/Web'e doğrudan
# alternatif geçiş YOKTUR (bkz. cloudflared-config.yml.template).
#
# Parametreler (ortam değişkeni; varsayılanlar canlı topoloji):
#   CADDY_LISTEN  varsayılan 127.0.0.1:8081   — tünelin bağlandığı tek giriş
#   WEB_UPSTREAM  varsayılan 127.0.0.1:3002   — Next.js (sayfalar + /_next varlıkları)
#   API_UPSTREAM  varsayılan 127.0.0.1:8080   — NestJS (global prefix "api"; YOL DÖNÜŞÜMÜ YOK)
#
# Kural: izin listesi dışındaki HER yol/yöntem 403 alır ve arka uca hiç gitmez.
# İzin listesi paket §2.1 ile birebir.
#
# R02'de düzeltilen iki ölçülmüş kusur (kanıt: paket §10.1):
#   Ş-1  Site adresi `{$PUBLIC_HOST}` idi → `caddy adapt` çıktısı `listen [":443"]` ve
#        automatic_https AÇIK üretiyordu: Caddy TÜM arayüzlerde 443 açıp ACME deniyordu.
#        Tünel arkasında TLS sağlayıcıda sonlanır; Caddy yalnız loopback HTTP dinlemelidir.
#   Ş-2  `respond @deny 403` site bloğunda serbest duruyordu; Caddy'nin varsayılan direktif
#        sıralamasında `respond`, `handle`'dan SONRA gelir. Admin reddi fiilen ERİŞİLMEZDİ
#        (catch-all 403 sonucu maskeliyordu). Artık tüm karar tek `route` içinde, yazım sırasıyla.

{
	admin off
	auto_https off
}

{$CADDY_LISTEN:127.0.0.1:8081} {
	@deny path_regexp deny ^/api/portal/admin(/|$)

	@web_get {
		method GET
		path_regexp web ^/(intake/[^/]+|portal(/(login|forgot-password|reset-password|cases|documents|financial-disclosures|messages|poas|profile))?|portal/cases/[^/]+|_next/.+|favicon\.ico)$
	}
	@api_get {
		method GET
		path_regexp aget ^/api/(public/intake/[^/]+|portal/(cases|cases/[^/]+|financial-disclosures|financial-disclosures/history|financial-disclosures/[^/]+|poas|notifications|notifications/unread-count|documents|documents/[^/]+/download|messages|messages/unread-count))$
	}
	@api_post {
		method POST
		path_regexp apost ^/api/(public/intake/[^/]+|portal/(login|forgot-password|reset-password|change-password|notifications/[^/]+/read|notifications/read-all|messages|messages/mark-read|documents/upload))$
	}
	@api_delete {
		method DELETE
		path_regexp adel ^/api/portal/documents/[^/]+$
	}

	# Tek karar zinciri — sıra yazım sırasıdır (Ş-2).
	route {
		# 1) Personel yönetim uçları portal ön ekinde olsa bile REDDEDİLİR (listenin en kritik satırı).
		respond @deny 403

		# 2) Yükleme sınırı: API 10 MB (portal.controller.ts); kenar biraz üstünde tutulur.
		request_body @api_post {
			max_size 11MB
		}

		# 3) İzin listesi — API. İstemciden gelen X-Forwarded-For SİLİNİR, kenar kendi gördüğü adresi yazar.
		reverse_proxy @api_get {$API_UPSTREAM:127.0.0.1:8080} {
			header_up X-Forwarded-For {remote_host}
		}
		reverse_proxy @api_post {$API_UPSTREAM:127.0.0.1:8080} {
			header_up X-Forwarded-For {remote_host}
		}
		reverse_proxy @api_delete {$API_UPSTREAM:127.0.0.1:8080} {
			header_up X-Forwarded-For {remote_host}
		}

		# 4) İzin listesi — Web (sayfalar ve /_next varlıkları; bunlar olmadan sayfa çizilmez).
		reverse_proxy @web_get {$WEB_UPSTREAM:127.0.0.1:3002} {
			header_up X-Forwarded-For {remote_host}
		}

		# 5) VARSAYILAN RET — personel sayfaları, /auth/*, /api/auth/*, diğer tüm uçlar.
		respond 403
	}
}
