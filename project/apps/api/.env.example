# Local development examples only. Do not use these values in production.
#
# SECRET DEGERLERI BU DOSYAYA YAZILMAZ. Asagida degeri BOS birakilan anahtarlar
# (DATABASE_URL, JWT_SECRET) secret tasir: gercek degerleri repo disinda, dar ACL'li
# bir dosyada uretin ve yalniz git-ignored `apps/api/.env` icine yazin.
# Bu dosyadaki bir degeri production'a KOPYALAMAYIN. Bkz. `docker/.env.example`.

# Database
# Bicim: postgresql://<kullanici>:<parola>@localhost:5432/hukuk_db  (parola BOS birakilmaz)
DATABASE_URL=

# JWT
# Rastgele ve yeterince uzun bir deger uretin, ornegin: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# App
PORT=8080
NODE_ENV=development

# UYAP operasyonel erisilebilirlik sinyali (ops-controlled)
# UYAP-SEND-HARD-GATE-PREFLIGHT-R02: UYAP_SEND artik bu sinyalin ACIKCA
# yapilandirilmis olmasini ister. Tanimsiz veya bos birakilirsa "available"
# SAYILMAZ; UYAP_SEND fail-closed olarak bloklanir
# (gate: UYAP_SEND_PRECONDITIONS_UNPROVEN). Diger action'lar etkilenmez.
# Deger: true|false|0|disabled  (false/0/disabled = gecici ariza)
UYAP_AVAILABLE=true
